<form class="character-forge-origin" autocomplete="off">

  <p class="hint">{{localize "CHARFORGE.Origin.prompt" name=actorName}}</p>

  <fieldset>
    <legend>{{localize "CHARFORGE.Origin.species"}}</legend>
    <div class="row">
      <select id="cf-species" name="species">
        {{selectOptions speciesChoices blank=(localize "CHARFORGE.Origin.none")}}
      </select>
    </div>
    {{#if existingSpecies}}
      <p class="hint">{{localize "CHARFORGE.Origin.replacing" current=existingSpecies}}</p>
    {{/if}}
  </fieldset>

  <fieldset>
    <legend>{{localize "CHARFORGE.Origin.class"}}</legend>
    <div class="row">
      <select id="cf-class" name="class">
        {{selectOptions classChoices blank=(localize "CHARFORGE.Origin.none")}}
      </select>
    </div>
    {{#if existingClass}}
      <p class="hint">{{localize "CHARFORGE.Origin.replacing" current=existingClass}}</p>
    {{/if}}
    <p class="hint">{{localize "CHARFORGE.Origin.hpHint"}}</p>
  </fieldset>

  <div class="form-footer">
    <button type="button" data-action="skipOrigin">
      <i class="fa-solid fa-forward"></i> {{localize "CHARFORGE.Origin.skip"}}
    </button>
    <button type="button" data-action="applyOrigin">
      <i class="fa-solid fa-check"></i> {{localize "CHARFORGE.Origin.apply"}}
    </button>
  </div>

</form>
