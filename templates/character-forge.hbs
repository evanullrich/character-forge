<form class="character-forge-form" autocomplete="off">

  <fieldset>
    <legend>{{localize "CHARFORGE.Dialog.actorSelect"}}</legend>
    <div class="row">
      <select name="actorId">
        {{#if canCreate}}
          {{selectOptions actorChoices selected=selectedActorId blank=(localize "CHARFORGE.Dialog.newActor")}}
        {{else}}
          {{selectOptions actorChoices selected=selectedActorId}}
        {{/if}}
      </select>
      {{#unless canCreate}}
        <p class="hint">{{localize "CHARFORGE.Dialog.ownedOnlyHint"}}</p>
      {{/unless}}
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "CHARFORGE.Dialog.identity"}}</legend>
    <div class="row">
      <label for="cf-name">{{localize "CHARFORGE.Dialog.name"}}</label>
      <input id="cf-name" type="text" name="name" placeholder="{{localize 'CHARFORGE.Dialog.name'}}" />
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "CHARFORGE.Dialog.abilities"}}</legend>
    <div class="abilities-grid">
      {{#each abilities as |key|}}
        <div class="ability-block">
          <label for="cf-ability-{{key}}">{{key}}</label>
          <input id="cf-ability-{{key}}" type="number" name="abilities.{{key}}" value="10" min="1" max="30" />
        </div>
      {{/each}}
    </div>
    <div class="row">
      <button type="button" data-action="rollAbilities">
        <i class="fa-solid fa-dice-d6"></i> {{localize "CHARFORGE.Dialog.rollAbilities"}}
      </button>
      <button type="button" data-action="standardArray">
        <i class="fa-solid fa-list-ol"></i> {{localize "CHARFORGE.Dialog.standardArray"}}
      </button>
      <button type="button" data-action="togglePointBuy">
        <i class="fa-solid fa-calculator"></i> {{localize "CHARFORGE.Dialog.pointBuy"}}
      </button>
    </div>
    <p class="point-buy-status" hidden></p>
  </fieldset>

  <fieldset>
    <legend>{{localize "CHARFORGE.Dialog.hp"}}</legend>
    <div class="row">
      <label for="cf-hp-value">{{localize "CHARFORGE.Dialog.hpValue"}}</label>
      <input id="cf-hp-value" type="number" name="hp.value" value="0" min="0" />
      <label for="cf-hp-max">{{localize "CHARFORGE.Dialog.hpMax"}}</label>
      <input id="cf-hp-max" type="number" name="hp.max" min="0" placeholder="{{localize 'CHARFORGE.Dialog.hpMaxAuto'}}" />
      <button type="button" data-action="rollHp">
        <i class="fa-solid fa-dice-d20"></i> {{localize "CHARFORGE.Dialog.rollHp"}}
      </button>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "CHARFORGE.Dialog.details"}}</legend>
    <div class="row">
      <label for="cf-alignment">{{localize "CHARFORGE.Dialog.alignment"}}</label>
      <select id="cf-alignment" name="alignment">
        {{selectOptions alignments blank="" valueAttr="label" labelAttr="label"}}
      </select>
    </div>
    <div class="row">
      <label for="cf-background">{{localize "CHARFORGE.Dialog.background"}}</label>
      <input id="cf-background" type="text" name="background" />
    </div>
  </fieldset>

  <div class="form-footer">
    <button type="button" data-action="apply">
      <i class="fa-solid fa-check"></i> {{localize "CHARFORGE.Dialog.apply"}}
    </button>
  </div>

</form>
